# Copy to `.env` for local use. Do not commit `.env`.
# `.env` overrides these defaults. Compose and the API both read them.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vroometr
POSTGRES_PASSWORD=vroometr
POSTGRES_DB=vroometr

# Redis (Celery broker later)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LocalStack S3 (not real AWS)
LOCALSTACK_PORT=4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=vroometr-dev

# API
API_HOST=0.0.0.0
API_PORT=8000

# Celery worker
CELERY_LOG_LEVEL=info

# Feature flags (OpenFeature). Use inmemory for tests; unleash when Compose is up.
FLAGS_PROVIDER=unleash
UNLEASH_PORT=4242
UNLEASH_URL=http://localhost:4242/api
UNLEASH_API_TOKEN=*:development.unleash-insecure-local-token
UNLEASH_APP_NAME=vroometr
UNLEASH_ADMIN_PASSWORD=unleash-local-admin
UNLEASH_DATABASE_HOST=postgres
UNLEASH_DATABASE_PORT=5432
UNLEASH_DATABASE_NAME=unleash

# AI model names — vendor adapters are not wired yet. Leave blank until chosen.
AGENT_MODEL=
ESCALATION_MODEL=
SUMMARY_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
STT_MODEL=
TTS_MODEL=
IMAGE_MODEL=
RERANKER_MODEL=
