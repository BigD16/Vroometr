# Copy to `.env` and fill every key. Do not commit `.env`.
# This file lists names only — no values.

# Postgres
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (Celery broker)
REDIS_PORT=
REDIS_URL=

# LocalStack S3 (not real AWS)
LOCALSTACK_PORT=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET=

# API
API_HOST=
API_PORT=

# Celery worker
CELERY_LOG_LEVEL=
# Lease for attachment checks, page extraction, and indexing retries.
PROCESSING_LEASE_SECONDS=

# Feature flags (OpenFeature). inmemory or unleash.
FLAGS_PROVIDER=
UNLEASH_PORT=
UNLEASH_URL=
UNLEASH_API_TOKEN=
UNLEASH_APP_NAME=
UNLEASH_ADMIN_PASSWORD=
UNLEASH_DATABASE_HOST=
UNLEASH_DATABASE_PORT=
UNLEASH_DATABASE_NAME=

# Clerk identity. Fill from the Clerk dashboard. Do not trust the browser for role/plan.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTY=

# Website → API (Next.js server-side). Scheme + host + port, no trailing path.
API_URL=

# AI model names. Embeddings and AGENT_MODEL chat (tool-calling) are wired when
# OPENAI_* is set; other adapters remain unconfigured.
AGENT_MODEL=
ESCALATION_MODEL=
SUMMARY_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
STT_MODEL=
TTS_MODEL=
IMAGE_MODEL=
RERANKER_MODEL=

# Embeddings: API key stays server-side. Base URL includes the API version path.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Local embedding configuration revision; bump when embedding behavior changes.
EMBEDDING_VERSION=
EMBEDDING_TIMEOUT_SECONDS=

# Reranking uses the existing OpenAI key/base URL; timeout is per HTTP request.
RERANKER_TIMEOUT_SECONDS=
