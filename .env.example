# Copy to `.env` for local use. Do not commit `.env`.
# `.env` overrides these defaults. Compose and the API both read them.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vroometr
POSTGRES_PASSWORD=vroometr
POSTGRES_DB=vroometr

# Redis (Celery broker later)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LocalStack S3 (not real AWS)
LOCALSTACK_PORT=4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=vroometr-dev

# API
API_HOST=0.0.0.0
API_PORT=8000

# Celery worker
CELERY_LOG_LEVEL=info
